rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOps() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'paulabraham.net@gmail.com'
        || (
          request.auth.token.phone_number is string
          && request.auth.token.phone_number.matches('.*9346577926$')
        )
      );
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isOps()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOps();
    }
  }
}
